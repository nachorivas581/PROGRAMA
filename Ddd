$nombreUser = $_SESSION['nombre'];

// Validación inteligente para la foto (URL de Google vs Archivo Local)
if (!empty($_SESSION['foto'])) {
    if (strpos($_SESSION['foto'], 'http') === 0) {
        $fotoPerfil = $_SESSION['foto'];
    } else {
        $fotoPerfil = 'uploads/' . $_SESSION['foto'];
    }
} else {
    $fotoPerfil = 'https://cdn-icons-png.flaticon.com/512/149/149071.png';
}

$whatsappUser = $_SESSION['whatsapp'] ?? '';

// =======================================================
// TRAER CONFIGURACIÓN DE PAGOS DESDE ADMIN
// =======================================================
try {
    $config_app = $pdo->query("SELECT pago_efectivo, pago_mercadopago FROM configuracion LIMIT 1")->fetch(PDO::FETCH_ASSOC);
    $pago_efectivo_activo = $config_app ? (int)$config_app['pago_efectivo'] : 0;
    $pago_mp_activo = $config_app ? (int)$config_app['pago_mercadopago'] : 1;
} catch (PDOException $e) {
    $pago_efectivo_activo = 0;
    $pago_mp_activo = 1;
}

// =======================================================
// CARGAR RUBROS DINÁMICOS DESDE LA BASE DE DATOS
// =======================================================
$rubros_db = [];
try {
    $stmt_rubros = $pdo->query("SELECT nombre FROM rubros ORDER BY nombre ASC");
    $rubros_db = $stmt_rubros->fetchAll(PDO::FETCH_COLUMN);
} catch (PDOException $e) {
    $rubros_db = ['Plomería', 'Electricidad', 'Jardinería', 'Cerrajería'];
}

$iconos_rubros = [
    'Albañil' => '🧱', 'Electricista' => '⚡', 'Jardinería / Desmalezamiento' => '🌳',
    'Plomero' => '🚰', 'Podador' => '🪚', 'Refrigeración' => '❄️', "Computacion" => '💻',
    'Cadetería / Mensajería' => '🛵', 'Carpintero' => '🔨', 'Cerrajero' => '🔑',
    'Construcción en Seco / Durlock' => '🏗️', 'Fletes y Mudanzas' => '🚚',
    'Fumigación / Control de Plagas' => '🐜', 'Gasista Matriculado' => '🔥',
    'Herrero' => '⚒️', 'Instalador de Aires Acondicionados' => '❄️',
    'Instalador de Alarmas y Cámaras' => '📹', 'Limpieza y Maestranza' => '🧹',
    'Pintor' => '🎨', 'Piletero / Mantenimiento de Piscinas' => '🏊‍♂️',
    'Reparación de Electrodomésticos' => '🔌', 'Reparación de Lavarropas' => '🧺',
    'Tapicero' => '🪑', 'Vidriero' => '🪟','Mecanico' => '🚙',
];

// =======================================================
// PLAN B: ATRAPAR EL RETORNO DE MERCADO PAGO
// =======================================================
if (isset($_GET['status']) && isset($_GET['external_reference'])) {
    $status = $_GET['status'];
    $pedido_id = $_GET['external_reference'];
    $payment_id = $_GET['payment_id'] ?? ($_GET['collection_id'] ?? '0');

    if ($status === 'approved') {
        $stmt = $pdo->prepare("UPDATE solicitudes SET estado = 'en_curso', transaccion_cliente = ? WHERE id = ? AND estado = 'pendiente_pago'");
        $stmt->execute([$payment_id, $pedido_id]);
        header("Location: index.php?msg=pago_aprobado"); exit();
    } elseif ($status === 'in_process' || $status === 'pending') {
        $stmt = $pdo->prepare("UPDATE solicitudes SET estado = 'en_curso', transaccion_cliente = ? WHERE id = ? AND estado = 'pendiente_pago'");
        $stmt->execute([$payment_id . '_PENDING', $pedido_id]);
        header("Location: index.php?msg=pago_pendiente"); exit();
    } elseif ($status === 'rejected' || $status === 'null') {
        header("Location: index.php?msg=pago_rechazado"); exit();
    }
}
