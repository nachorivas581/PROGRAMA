    const map = L.map('mapa', { zoomControl: false, attributionControl: false }).setView([-38.9392, -67.9892], 14);
    let capaMapaActual = L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png').addTo(map);

    let marcadores = [], miMarker = null, miLat = null, miLng = null;

// Variable global para guardar el ID del rastreador nativo por si alguna vez querés frenarlo
let watchIdNativo = null;

async function iniciarGPS() {
    // 1. MODO APP NATIVA (APK)
    if (window.Capacitor && window.Capacitor.isNativePlatform()) {
        const { Geolocation } = Capacitor.Plugins;

        try {
            // Validamos permisos con Android
            const permisos = await Geolocation.requestPermissions();

            if (permisos.location === 'granted' || permisos.coarseLocation === 'granted') {
                // Usamos el watchPosition de Capacitor para rastreo continuo
                watchIdNativo = await Geolocation.watchPosition(
                    { enableHighAccuracy: true, timeout: 10000 },
                    (pos, err) => {
                        if (err) {
                            console.error("Error en GPS Nativo:", err);
                            return; // Ignoramos timeouts menores y seguimos escuchando
                        }

                        if (pos) {
                            miLat = pos.coords.latitude;
                            miLng = pos.coords.longitude;

                            // Lógica intacta de tu mapa Leaflet
                            if (!miMarker) {
                                miMarker = L.marker([miLat, miLng], {
                                    icon: L.divIcon({html:'<div class="gps-pulse"></div>', className:''})
                                }).addTo(map);
                                map.setView([miLat, miLng], 15);
                            } else {
                                miMarker.setLatLng([miLat, miLng]);
                            }

                            // Cargamos la data
                            cargarDatos(miLat, miLng);
                            cargarMisPedidos();
                        }
                    }
                );
            } else {
                mostrarAlerta('Ubicación Bloqueada', 'Activa los permisos de GPS desde la configuración de Android.', 'warning');
            }
        } catch (e) {
            console.error("Error iniciando GPS Nativo:", e);
        }

    } else {
        // 2. MODO WEB CLÁSICO (El código que ya tenías)
        if (!navigator.geolocation) return mostrarAlerta('Aviso', 'Tu dispositivo no soporta ubicación GPS.', 'warning');

        navigator.geolocation.watchPosition(pos => {
            miLat = pos.coords.latitude; miLng = pos.coords.longitude;

            if (!miMarker) {
                miMarker = L.marker([miLat, miLng], { icon: L.divIcon({html:'<div class="gps-pulse"></div>', className:''}) }).addTo(map);
                map.setView([miLat, miLng], 15);
            } else {
                miMarker.setLatLng([miLat, miLng]);
            }

            cargarDatos(miLat, miLng);
            cargarMisPedidos();

        }, e => {
            if(e.code === 1) mostrarAlerta('Ubicación Bloqueada', 'Activa el GPS para poder encontrar profesionales.', 'warning');
            if(e.code === 3) setTimeout(iniciarGPS, 3000); // Reintento por timeout
        }, { enableHighAccuracy: true, timeout: 10000 });
    }
}
    function cargarDatos(lat, lng) {
