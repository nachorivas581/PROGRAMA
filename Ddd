    if ('serviceWorker' in navigator) { window.addEventListener('load', () => { navigator.serviceWorker.register('sw.js'); }); }

    function urlBase64ToUint8Array(base64String) {
        const padding = '='.repeat((4 - base64String.length % 4) % 4);
        const base64 = (base64String + padding).replace(/\-/g, '+').replace(/_/g, '/');
        const rawData = window.atob(base64); const outputArray = new Uint8Array(rawData.length);
        for (let i = 0; i < rawData.length; ++i) { outputArray[i] = rawData.charCodeAt(i); } return outputArray;
    }

    function solicitarPermisosPush() {
        if (!('serviceWorker' in navigator) || !('PushManager' in window)) return mostrarAlerta('Aviso', 'Tu dispositivo no soporta notificaciones push.', 'warning');
        Notification.requestPermission().then(p => { if (p === 'granted') suscribirUsuario(); else mostrarAlerta('Alerta', 'No diste permiso para recibir notificaciones.', 'warning'); });
