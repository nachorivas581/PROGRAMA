        }
        document.getElementById('pago_profesional_id').value = profesionalId;
        document.getElementById('pago_cotizacion_id').value = cotizacionId;

        let pBase = parseFloat(precioBase) || 0;

        // Si ES un trabajo extra, no le sumamos el 15%.
        let precioMP = isExtra ? pBase : pBase * 1.15;

        preciosCalculados = { 'base': pBase, 'efectivo': pBase, 'mercadopago': precioMP };
