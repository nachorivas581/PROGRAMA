                        <div class="pro-online-dot"></div>
                        ${verif ? '<div class="pro-shield"><i class="bi bi-shield-check"></i></div>' : ''}
                    </div>
                `;

                let m = L.marker([item.latitud, item.longitud], { icon: L.divIcon({ html: iconHtml, iconSize: [50, 50], className: '' }) }).addTo(map);
                m.on('click', () => { verSeguridad(item.id || item.profesional_id, item.nombre, item.rubro, foto, item.verificado); });
                marcadores.push(m);
            });
        });
