    function ejecutarPago(metodo) {
        const pedidoId = document.getElementById('pago_pedido_id').value;
        const montoFinal = preciosCalculados[metodo];
        const proId = document.getElementById('pago_profesional_id') ? document.getElementById('pago_profesional_id').value : '';
        const cotizId = document.getElementById('pago_cotizacion_id') ? document.getElementById('pago_cotizacion_id').value : '';
        const precioPro = preciosCalculados['base'];

        if (metodo === 'efectivo') {
            Swal.fire({ title: 'Confirmando...', text: 'Enviando confirmación...', icon: 'info', showConfirmButton: false, allowOutsideClick: false });

            const fdEf = new URLSearchParams();
            fdEf.append('pedido_id', pedidoId); fdEf.append('precio_pro', precioPro); fdEf.append('profesional_id', proId);

            fetch('procesar_pago_efectivo.php', { method: 'POST', body: fdEf }).then(r => r.json()).then(res => {
                if(res.success) {
                    Swal.close();
                    bootstrap.Modal.getInstance(document.getElementById('modalMetodoPago')).hide();
                    mostrarAlerta("¡Confirmado!", "Elegiste pagar en efectivo. Asegurate de pedir el comprobante al profesional.", "success");
                    cargarMisPedidos();
                } else { mostrarAlerta("Error", "No se pudo confirmar el pago.", "error"); }
            }).catch(() => { mostrarAlerta("Error", "Problema de red.", "error"); });
        }
        else if (metodo === 'mercadopago') {
            Swal.fire({ title: 'Conectando...', text: 'Abriendo pasarela...', icon: 'info', showConfirmButton: false, allowOutsideClick: false });
            const fdMP = new URLSearchParams();
            fdMP.append('pedido_id', pedidoId); fdMP.append('monto_final', montoFinal); fdMP.append('precio_pro', precioPro); fdMP.append('profesional_id', proId); fdMP.append('cotizacion_id', cotizId);

            fetch('generar_pago_mp.php', { method: 'POST', body: fdMP }).then(r => r.json()).then(res => {
                if(res.success) { Swal.close(); window.location.href = res.url_pago; }
                else { mostrarAlerta("Error", "Error al generar el link de pago.", "error"); }
            }).catch(() => { mostrarAlerta("Error", "Problema de red. Intentá de nuevo.", "error"); });
        }
    }

    let pedidosProcesadosParaCalificar = [];
    let ultimoContenidoPedidos = "";
    let conteoCotizacionesPrevias = {};

    function cargarMisPedidos() {
        fetch('obtener_mis_pedidos.php?t=' + new Date().getTime())
        .then(r => r.json())
        .then(pedidos => {
            const container = document.getElementById('mis-pedidos-container');
            const mainUI = document.getElementById('main-request-ui');

            if (!pedidos || pedidos.length === 0) {
                if (ultimoContenidoPedidos !== "") {
                    container.innerHTML = "";
                    if (mainUI) mainUI.style.display = 'block';
                    ultimoContenidoPedidos = "";
                }
                return;
            }

            const pedidosActivos = pedidos.filter(p => p.estado === 'pendiente' || p.estado === 'en_curso' || p.estado === 'pendiente_pago');

            if (pedidosActivos.length > 0) {
                if (mainUI && mainUI.style.display !== 'none') mainUI.style.display = 'none';
            } else {
                if (mainUI && mainUI.style.display !== 'block') mainUI.style.display = 'block';
            }

            let nuevoHTML = pedidosActivos.map(p => {
                let rubro = p.rubro_solicitado || p.rubro || 'Servicio';

                // Detectamos si es un cobro extra
                let isExtra = rubro && rubro.includes('Trabajo Final');

                if(p.estado === 'pendiente') {
                    if (!p.cotizaciones || p.cotizaciones.length === 0) {
                        return `
                        <div class="floating-bottom-card text-center border-top border-dark border-4 bg-white shadow" style="margin-bottom: 10px;">
                            <div class="spinner-grow text-dark spinner-grow-sm mb-3" role="status"></div>
                            <h4 class="fw-bolder text-dark mb-1" style="font-family:'Montserrat', sans-serif;">Buscando ${rubro}...</h4>
                            <p class="small text-muted mb-4 fw-medium">Conectando con profesionales cercanos</p>
                            <button type="button" class="btn btn-light border rounded-pill px-4 fw-bold w-100 py-3 shadow-sm" onclick="finalizarPedido(${p.id})">Cancelar búsqueda</button>
                        </div>`;
                    } else {
                        if (!conteoCotizacionesPrevias[p.id]) conteoCotizacionesPrevias[p.id] = 0;
                        if (p.cotizaciones.length > conteoCotizacionesPrevias[p.id]) {
                            document.getElementById('notif-sound').play().catch(()=>{});
                            if(navigator.vibrate) navigator.vibrate([200, 100, 200]);
                            conteoCotizacionesPrevias[p.id] = p.cotizaciones.length;
                        }

                        let htmlCotizaciones = `<div class="mb-3 text-center"><span class="badge bg-dark px-3 py-2 fs-6 rounded-pill shadow-sm">¡${p.cotizaciones.length} Ofertas de Visita!</span></div>`;

                        p.cotizaciones.forEach(cotiz => {
                            let fotoPro = cotiz.foto ? (cotiz.foto.startsWith('http') ? cotiz.foto : `uploads/${cotiz.foto}`) : 'https://cdn-icons-png.flaticon.com/512/149/149071.png';
                            let precioFmt = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits:0 }).format(cotiz.precio_oferta);
                            let estrellas = cotiz.estrellas > 0 ? `<i class="bi bi-star-fill text-warning"></i> ${parseFloat(cotiz.estrellas).toFixed(1)}` : 'Nuevo';

                            htmlCotizaciones += `
                            <div class="bg-white p-3 mb-3 rounded-4 border shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
                                    <div class="d-flex align-items-center">
                                        <div style="width:55px;height:55px;border-radius:18px;background-image:url('${fotoPro}');background-size:cover;margin-right:12px; border:1px solid #eee;"></div>
                                        <div style="line-height: 1.2;">
                                            <span class="fw-bolder d-block text-truncate text-dark" style="max-width: 140px; font-size: 15px;">${cotiz.nombre}</span>
                                            <span class="small text-muted fw-bold">${estrellas}</span>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <span class="fw-bolder text-success fs-3 d-block">${precioFmt}</span>
                                        <span class="small text-muted fw-bold" style="font-size: 10px;">Costo por Visita</span>
                                    </div>
                                </div>
                                <div class="d-flex gap-2 mt-3">
                                    <button class="btn btn-light border text-muted fw-bold rounded-pill w-50 py-2" onclick="verSeguridad(${cotiz.profesional_id}, '${cotiz.nombre}', '${rubro}', '${fotoPro}', ${cotiz.verificado})">Perfil</button>
                                    <button class="btn btn-dark fw-bold rounded-pill shadow-sm w-50 py-2" onclick="iniciarPago(${p.id}, '${cotiz.precio_oferta}', ${cotiz.profesional_id}, ${cotiz.cotizacion_id}, false)">ACEPTAR</button>
                                </div>
                            </div>`;
                        });

                        return `
                        <div class="floating-bottom-card bg-white shadow" style="max-height: 65vh; overflow-y: auto; margin-bottom: 10px;">
                            <div class="d-flex justify-content-end mb-2"><button type="button" class="btn btn-sm btn-light border rounded-pill text-danger fw-bold py-2 px-3" onclick="finalizarPedido(${p.id})">Cancelar</button></div>
                            ${htmlCotizaciones}
                        </div>`;
                    }
                }
                else if (p.estado === 'en_curso') {
                    let fotoPro = p.foto_pro ? (p.foto_pro.startsWith('http') ? p.foto_pro : `uploads/${p.foto_pro}`) : 'https://cdn-icons-png.flaticon.com/512/149/149071.png';

                    let textEnCamino = isExtra ? "Trabajo en ejecución" : "El profesional está en camino";
                    let infoExtra = "";
                    if (p.transaccion_cliente && p.transaccion_cliente.includes('_PENDING')) {
                        textEnCamino = "Pago Pendiente / En Revisión";
                        infoExtra = "<div class='alert alert-warning small py-2 px-3 rounded-3 mb-3 fw-bold border-warning'><i class='bi bi-hourglass-split me-1'></i> Revisando acreditación del pago...</div>";
                    }

                    return `
                    <div class="floating-bottom-card border-top border-dark border-4 bg-white shadow" style="margin-bottom: 10px;">
                        <div class="text-center mb-3">
                            <span class="badge bg-dark text-white px-4 py-2 rounded-pill shadow-sm fs-6">${textEnCamino}</span>
                        </div>
                        ${infoExtra}
                        <div class="d-flex align-items-center mb-4 bg-light p-3 rounded-4 border shadow-sm">
                            <div style="width:65px;height:65px;border-radius:50%;background-image:url('${fotoPro}');background-size:cover;margin-right:15px; border: 3px solid var(--brand-dark);"></div>
                            <div>
                                <h4 class="fw-bolder mb-0 text-dark" style="font-family:'Montserrat',sans-serif;">${p.nombre_pro || 'Profesional'}</h4>
                                <div class="small fw-bold text-muted text-uppercase" style="letter-spacing:1px;">${rubro}</div>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="https://wa.me/${p.whatsapp_pro}" target="_blank" class="btn btn-light border fw-bold w-50 rounded-pill py-3 shadow-sm"><i class="bi bi-chat-dots-fill text-dark fs-5 align-middle"></i> Mensaje</a>
                            <button type="button" class="btn btn-dark fw-bold w-50 rounded-pill py-3 shadow-sm" onclick="finalizarPedido(${p.id})">Terminado</button>
                        </div>
                    </div>`;
                }
                else if (p.estado === 'pendiente_pago') {
                    let fotoPro = p.foto_pro ? (p.foto_pro.startsWith('http') ? p.foto_pro : `uploads/${p.foto_pro}`) : 'https://cdn-icons-png.flaticon.com/512/149/149071.png';
                    let precio = p.precio || p.precio_oferta || 0;

                    let textoCartel = isExtra ? "Pago de Trabajo Requerido" : "Pago de Visita Requerido";
                    let textoBotonPago = isExtra ? "Pagar Trabajo" : "Pagar Visita";

                    return `
                    <div class="floating-bottom-card border-top border-danger border-4 bg-white shadow" style="margin-bottom: 10px;">
                        <div class="text-center mb-3"><span class="badge bg-danger text-white px-4 py-2 rounded-pill shadow-sm fs-6">${textoCartel}</span></div>
                        <div class="d-flex align-items-center mb-4 bg-light p-3 rounded-4 border shadow-sm">
                            <div style="width:65px;height:65px;border-radius:50%;background-image:url('${fotoPro}');background-size:cover;margin-right:15px; border: 3px solid var(--brand-dark);"></div>
                            <div>
                                <h4 class="fw-bolder mb-0 text-dark" style="font-family:'Montserrat',sans-serif;">${p.nombre_pro || 'Profesional'}</h4>
                                <div class="small fw-bold text-muted text-uppercase">${rubro}</div>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-light border fw-bold w-50 rounded-pill py-3 text-danger" onclick="finalizarPedido(${p.id})">Cancelar</button>
                            <button type="button" class="btn btn-dark fw-bold w-50 rounded-pill py-3" onclick="iniciarPago(${p.id}, '${precio}', ${p.profesional_id}, ${p.cotizacion_id}, ${isExtra})">${textoBotonPago}</button>
                        </div>
                    </div>`;
                }
                return "";
            }).join('');

            if (nuevoHTML !== ultimoContenidoPedidos) {
                container.innerHTML = nuevoHTML;
                ultimoContenidoPedidos = nuevoHTML;
            }

            pedidos.forEach(p => {
                if (p.estado === 'finalizado' && !pedidosProcesadosParaCalificar.includes(p.id)) {
                    pedidosProcesadosParaCalificar.push(p.id);
                    abrirConfirmacionTrabajo(p.id);
                }
            });
        });
    }

    function verSeguridad(pro_id, n, r, f, v) {
        document.getElementById('p-nombre').innerText = n;
        document.getElementById('p-rubro').innerText = r;
        document.getElementById('p-foto').style.backgroundImage = `url('${f}')`;

        const badge = document.getElementById('p-verificado');
        const info = document.getElementById('p-info-segura');

        if(Number(v) === 1) {
            badge.innerHTML = '<span class="badge bg-dark px-4 py-2 rounded-pill shadow-sm"><i class="bi bi-shield-fill-check text-success"></i> PROFESIONAL VERIFICADO</span>';
            info.innerHTML = "Identidad validada, el profesional no cuenta con antecedentes penales.";
        } else {
            badge.innerHTML = '<span class="badge bg-secondary px-4 py-2 rounded-pill shadow-sm"><i class="bi bi-exclamation-triangle-fill text-warning"></i> NO VERIFICADO</span>';            info.innerHTML = "El usuario no ha validado su identidad ni antecedentes. Toma precauciones con el ingreso al hogar.";
        }

        const resenasLista = document.getElementById('p-resenas-lista');
        resenasLista.innerHTML = '<div class="text-center text-muted small py-3"><div class="spinner-border spinner-border-sm text-primary mb-2"></div><br>Cargando opiniones...</div>';

        new bootstrap.Modal(document.getElementById('modalPerfil')).show();

        fetch(`obtener_resenas.php?pro_id=${pro_id}`)
        .then(res => res.json())
        .then(data => {
            if(!data || data.length === 0) {
                resenasLista.innerHTML = '<div class="text-center text-muted small py-3 bg-light rounded-3 fst-italic">Aún no tiene opiniones escritas.</div>';
            } else {
                resenasLista.innerHTML = data.map(resena => {
                    let estrellasHtml = '<i class="bi bi-star-fill text-warning"></i>'.repeat(resena.estrellas) + '<i class="bi bi-star text-warning"></i>'.repeat(5 - resena.estrellas);
                    let nombreCorto = resena.cliente_nombre ? resena.cliente_nombre.split(' ')[0] : 'Cliente';
                    return `
                    <div class="mb-3 pb-3 border-bottom">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-bold text-dark"><i class="bi bi-person-circle text-secondary me-1"></i> ${nombreCorto}</span>
                            <span class="small">${estrellasHtml}</span>
                        </div>
                        <p class="small text-muted mb-0 fst-italic" style="line-height: 1.4;">"${resena.comentario}"</p>
                    </div>`;
                }).join('');
            }
        }).catch(() => { resenasLista.innerHTML = '<div class="text-center text-danger small py-2">Error al cargar las opiniones.</div>'; });
    }

    let pedidoAConfirmar = null;

    function abrirConfirmacionTrabajo(id) {
        pedidoAConfirmar = id;
        new bootstrap.Modal(document.getElementById('modalConfirmarTrabajo')).show();
        document.getElementById('notif-sound').play();
    }

    function trabajoRealizado() {
        Swal.fire({ title: 'Finalizando...', text: 'Liberando pago al profesional', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
        const fd = new URLSearchParams(); fd.append('pedido_id', pedidoAConfirmar);
        fetch('procesar_finalizacion.php', { method: 'POST', body: fd }).then(r => r.json()).then(res => {
            Swal.close();
            if(res.success) {
                bootstrap.Modal.getInstance(document.getElementById('modalConfirmarTrabajo')).hide();
                document.getElementById('calificar_pedido_id').value = pedidoAConfirmar;
                new bootstrap.Modal(document.getElementById('modalCalificar')).show();
            } else { mostrarAlerta("Error", "No se pudo finalizar el pago.", "error"); }
        });
    }

    function trabajoNoRealizado() {
        bootstrap.Modal.getInstance(document.getElementById('modalConfirmarTrabajo')).hide();
        const fd = new URLSearchParams(); fd.append('pedido_id', pedidoAConfirmar);
        fetch('reportar_problema.php', { method: 'POST', body: fd }).then(r => r.json()).then(res => {
            if (res.success) { mostrarAlerta("Reporte Enviado", "Hemos pausado el pago.", "warning"); cargarMisPedidos(); }
        });
    }

    function enviarCalificacion() {
        const id = document.getElementById('calificar_pedido_id').value;
        const est = document.getElementById('calificar_estrellas').value;
        if(est == 0) { mostrarAlerta("Atención", "Por favor seleccioná las estrellas.", "warning"); return; }
        const fd = new URLSearchParams(); fd.append('pedido_id', id); fd.append('estrellas', est); fd.append('comentario', document.getElementById('calificar_comentario').value);
        fetch('guardar_resena.php', { method: 'POST', body: fd }).then(r => r.json()).then(res => {
            if(res.success) {
                bootstrap.Modal.getInstance(document.getElementById('modalCalificar')).hide();
                mostrarAlerta("¡Gracias!", "Tu calificación ayuda a mejorar la comunidad.", "success");
                cargarMisPedidos();
            }
        });
    }

    document.querySelectorAll('.rating-star').forEach(star => {
        star.addEventListener('click', function() {
            const val = this.getAttribute('data-value');
            document.getElementById('calificar_estrellas').value = val;
            document.querySelectorAll('.rating-star').forEach(s => {
                s.classList.toggle('bi-star-fill', s.getAttribute('data-value') <= val);
                s.classList.toggle('bi-star', s.getAttribute('data-value') > val);
            });
        });
    });

    function finalizarPedido(id) {
        fetch('obtener_detalle_pedido.php?id=' + id).then(r => r.json()).then(pedido => {
            if (pedido.estado === 'en_curso') { abrirConfirmacionTrabajo(id); }
            else {
                Swal.fire({ title: '¿Cancelar solicitud?', text: "Los profesionales ya no verán tu pedido.", icon: 'warning', showCancelButton: true, confirmButtonColor: '#121212', confirmButtonText: 'Sí, cancelar', cancelButtonText: 'No', customClass: { popup: 'rounded-4', confirmButton: 'rounded-pill', cancelButton: 'rounded-pill' } }).then(result => {
                    if (result.isConfirmed) { fetch('eliminar_pedido.php?id=' + id).then(() => { cargarMisPedidos(); cargarDatos(miLat, miLng); }); }
                });
            }
        }).catch(() => {
             Swal.fire({ title: '¿Cancelar solicitud?', icon: 'warning', showCancelButton: true, confirmButtonColor: '#121212', confirmButtonText: 'Sí, cancelar', customClass: { popup: 'rounded-4', confirmButton: 'rounded-pill' } }).then(result => {
                if (result.isConfirmed) { fetch('eliminar_pedido.php?id=' + id).then(() => { cargarMisPedidos(); }); }
            });
        });
    }

    document.getElementById('formSolicitud')?.addEventListener('submit', function(e) {
        e.preventDefault();
        if(!miLat || !miLng) { mostrarAlerta("Ubicando...", "Buscando GPS. Esperá un segundo.", "info"); return; }
        const btn = document.getElementById('btnEnviar'); btn.disabled = true; btn.innerText = "PROCESANDO...";
        const fd = new URLSearchParams();
        fd.append('lat', miLat); fd.append('lng', miLng); fd.append('nombre', document.getElementById('sol_nombre').value);
        fd.append('whatsapp', document.getElementById('sol_whatsapp').value); fd.append('rubro_solicitado', document.getElementById('sol_rubro').value);
        fd.append('problema', document.getElementById('sol_problema').value);
        fetch('guardar_solicitud.php', { method: 'POST', body: fd }).then(r => r.json()).then(res => {
            btn.disabled = false; btn.innerText = 'SOLICITAR AHORA';
            if(res.status === 'success' || res.success) {
                bootstrap.Modal.getInstance(document.getElementById('modalAyuda')).hide();                document.getElementById('sol_problema').value = ""; conteoCotizacionesPrevias = {};
                cargarMisPedidos(); cargarDatos(miLat, miLng);
            } else { mostrarAlerta("Atención", res.message || "Faltan datos obligatorios.", "warning"); }
        }).catch(() => { btn.disabled = false; btn.innerText = 'SOLICITAR AHORA'; });
    });

    document.getElementById('formMiPerfil')?.addEventListener('submit', function(e) {
        e.preventDefault();
        const btn = document.getElementById('btnGuardarPerfil'); btn.disabled = true; btn.innerText = "GUARDANDO...";
        fetch('actualizar_perfil_cliente.php', { method: 'POST', body: new FormData(this) }).then(r => r.json()).then(res => {
            if(res.success) { location.reload(); } else { mostrarAlerta("Error", res.message, "error"); btn.disabled = false; }
        });
    });

    document.getElementById('formReporte')?.addEventListener('submit', function(e) {
        e.preventDefault();
        const btn = document.getElementById('btnEnviarReclamo'); const texto = document.getElementById('texto_reclamo').value;
        btn.disabled = true; btn.innerText = "ENVIANDO...";
        const nroTicket = 'RCL-' + Math.floor(1000 + Math.random() * 9000);
        const fd = new URLSearchParams(); fd.append('ticket', nroTicket); fd.append('detalle', texto);
        fetch('guardar_reclamo.php', { method: 'POST', body: fd }).then(r => r.json()).then(res => {
            btn.disabled = false; btn.innerText = "ENVIAR REPORTE";
            bootstrap.Modal.getInstance(document.getElementById('modalReportarProblema')).hide();
            document.getElementById('texto_reclamo').value = '';
            if(res.success) {
                mostrarAlerta("Ticket Creado", `Reclamo: ${nroTicket}.`, "success");
                window.open(`https://wa.me/5492990000000?text=${encodeURIComponent(`🚨 *RECLAMO*\n*Ticket:* ${nroTicket}\n*Detalle:* ${texto}`)}`, '_blank');
            }
        });
    });

    function cargarTickets() {
        const cont = document.getElementById('contenedor-tickets'); cont.innerHTML = `<div class="text-center py-5"><div class="spinner-border text-dark"></div></div>`;
        fetch('obtener_tickets.php').then(r => r.json()).then(data => {
            if (!Array.isArray(data) || data.length === 0) { cont.innerHTML = `<div class="text-center py-5 text-muted"><i class="bi bi-inbox fs-1 opacity-50"></i><p class="mt-2 fw-medium">No hay reclamos activos.</p></div>`; return; }
            cont.innerHTML = data.map(t => `<div class="p-4 mb-3 bg-white shadow-sm border rounded-4"><div class="d-flex justify-content-between mb-3"><span class="fw-bold text-dark fs-5"><i class="bi bi-hash text-dark"></i>${t.nro_ticket}</span><span class="badge bg-secondary border">${t.estado.toUpperCase()}</span></div><p class="small text-muted mb-3">${t.detalle}</p><div class="text-end border-top pt-3"><small class="text-muted fw-bold"><i class="bi bi-calendar3 me-1"></i> ${t.fecha_fmt}</small></div></div>`).join('');
        }).catch(() => { cont.innerHTML = `<div class="text-center py-5 text-muted"><i class="bi bi-inbox fs-1 opacity-50"></i><p class="mt-2 fw-medium">No hay reclamos activos.</p></div>`; });
    }

    function cargarHistorial() {
        const cont = document.getElementById('contenedor-historial'); cont.innerHTML = `<div class="text-center py-5"><div class="spinner-border text-dark"></div></div>`;
        fetch('obtener_historial.php').then(r => r.json()).then(data => {
            if (!Array.isArray(data) || data.length === 0) { cont.innerHTML = `<div class="text-center text-muted py-5"><i class="bi bi-clock-history fs-1 opacity-50"></i><p class="mt-2 fw-medium">Sin historial.</p></div>`; return; }
            cont.innerHTML = data.map(p => `<div class="p-4 mb-3 bg-white shadow-sm border rounded-4"><div class="d-flex justify-content-between mb-3"><span class="badge bg-dark px-3 py-1 rounded-pill">COMPLETADO</span><small class="text-muted fw-bold">${p.fecha || 'Reciente'}</small></div><h5 class="fw-bolder mb-1 text-dark" style="font-family:'Montserrat', sans-serif;">${p.rubro || 'Servicio'}</h5><p class="small text-muted mb-3 text-truncate">${p.problema}</p><div class="border-top pt-3"><span class="fw-bold text-dark small"><i class="bi bi-person-check-fill text-dark me-1"></i> ${p.profesional_nombre || 'Profesional'}</span></div></div>`).join('');
        }).catch(() => { cont.innerHTML = `<div class="text-center text-muted py-5"><i class="bi bi-clock-history fs-1 opacity-50"></i><p class="mt-2 fw-medium">Sin historial.</p></div>`; });
    }

    iniciarGPS();
    setInterval(() => { if(miLat && miLng) { cargarDatos(miLat, miLng); cargarMisPedidos(); } }, 10000);

</script>
</body>
</html>
