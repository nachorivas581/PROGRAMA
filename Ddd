    let preciosCalculados = {};

    function iniciarPago(pedidoId, precioBase, profesionalId = null, cotizacionId = null, isExtra = false) {
        if (!precioBase || precioBase === 'undefined' || precioBase === 'null') return mostrarAlerta("Error", "No se pudo recuperar el precio.", "error");

        document.getElementById('pago_pedido_id').value = pedidoId;
