        if(document.getElementById('lbl_precio_efectivo')) document.getElementById('lbl_precio_efectivo').innerText = fmt.format(preciosCalculados.efectivo);

        // Adaptamos el título del modal
        document.getElementById('titulo-modal-pago').innerText = isExtra ? "Pago de Trabajo" : "Pago de Visita";
        let alertaPago = document.getElementById('alerta-pago');
